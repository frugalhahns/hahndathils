":"https://limehollow.org/"},{"name":"Greek Peak Mountain Coaster","blurb":"Alpine coaster you control. Also a zipline and adventure center.","town":"Cortland","indoor":false,"drive":"15 min from Cortland","url":"https://www.greekpeak.net/"},{"name":"Cayuga Lake Wine Trail","blurb":"Tasting rooms up both shores. Sheldrake Point and Six Mile Creek are the easy picks.","town":"Cayuga Lake","indoor":false,"drive":"20-50 min","url":"https://cayugawinetrail.com/"},{"name":"Museum of the Earth","blurb":"Full mastodon and a right whale skeleton. Good rain plan, about 2 hours.","town":"Ithaca","indoor":true,"drive":"30 min from Cortland","url":"https://www.museumoftheearth.org/"},{"name":"Herbert F. Johnson Museum of Art","blurb":"Free. I.M. Pei building, and the 5th floor has the best view of Cayuga Lake.","town":"Ithaca","indoor":true,"drive":"in Cornell campus","url":"https://museum.cornell.edu/"},{"name":"Sciencenter","blurb":"Hands-on science museum. Built for kids but the outdoor mini golf is fun regardless.","town":"Ithaca","indoor":true,"drive":"in town","url":"https://www.sciencenter.org/"},{"name":"Center Ithaca / Ithaca Commons","blurb":"Food court with the soup dumplings, plus the pedestrian mall shops.","town":"Ithaca","indoor":true,"drive":"in town","url":"https://www.downtownithaca.com/"},{"name":"Cortland Beer Company","blurb":"Small taproom downtown Cortland. Closest good beer to the Airbnb.","town":"Cortland","indoor":true,"drive":"5 min from Airbnb","url":"https://www.cortlandbeer.com/"},{"name":"1890 House Museum","blurb":"Chateau-style mansion with a tower you can climb. Right in Cortland.","town":"Cortland","indoor":true,"drive":"5 min from Airbnb","url":"https://www.the1890house.org/"},{"name":"Cortland Repertory Theatre","blurb":"Summer stock at the Pavilion in Little York Lake. Check what is running.","town":"Cortland","indoor":true,"drive":"15 min from Airbnb","url":"https://www.cortlandrep.org/"}],"links":[{"label":"Waterfalls","url":"https://www.